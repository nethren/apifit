{
  "name": "apifit",
  "version": "0.1.0",
  "description": "Search APIs and MCP servers, understand their relevance to a product idea, and prepare an evidence-backed build brief.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run build && node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "node scripts/check.mjs && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "repo:check": "node scripts/repo-check.mjs",
    "ai:setup": "node scripts/ai-setup.mjs",
    "ai:check": "node scripts/ai-setup.mjs --status",
    "ai:eval": "node scripts/ai-eval.mjs",
    "search:eval": "node scripts/search-quality.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "ipaddr.js": "^2.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.5"
  }
}
