# EXAMPLE ONLY. Never put real values in this file or commit a local copy.
# The application does not automatically load dotenv files.
# Hosted values should come from the hosting provider's runtime secret settings.
APIFIT_MODE=hosted
APIFIT_PUBLIC_ORIGIN=
APIFIT_ACCESS_MODE=public
# For an optional private preview, set mode=password and provide a random secret:
# APIFIT_ACCESS_PASSWORD=
APIFIT_DATA_DIR=/data
PORT=8080
APIFIT_AI_ENABLED=false
# Only after an approved ledger migration and runtime-secret setup:
# ANTHROPIC_API_KEY=
